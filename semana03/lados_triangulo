#include <stdio.h>

int main() {

	printf("informe os lados do triangulo \n");
	int lado1, lado2, lado3;
	
	printf("informe o 1 lado do triangulo: ");
	scanf("%d", &lado1);
	
	printf("\n informe o 2 lado do triangulo: ");
	scanf("%d", &lado2);

	printf("\n informe o 3 lado do triangulo: ");
	scanf("%d", &lado3);

	if (lado1 > 0 && lado2 > 0 && lado3 > 0 && (lado1 + lado2) > lado3 && (lado1 + lado3) > lado2 && (lado3 + lado2) > lado1) {

		if (lado1 == lado2 && lado1 == lado3) {
			printf("triangulo equilatero \n");
		}

		else if (lado1 == lado2 || lado1 == lado3 || lado2 == lado3) {
			printf("triangulo isosceles \n");
		}

		else if (lado1 != lado2 && lado1 != lado3 && lado2 != lado3) {
			printf("triangulo escaleno \n");
		}
	}

	else {
		printf("informe valores validos para os lados do triangulo \n");
	}

	return 0;
}
